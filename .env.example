# Optional. Where the local SQLite database lives (default: data/linen-watch.db).
# LINEN_DB_PATH=data/linen-watch.db

# Set to 0 to turn off the fake network delay in mock sources.
# LINEN_MOCK_LATENCY=0

# Which sources the agent scans:
#   mock  the simulated sources only (default; use this for demos)
#   ebay  real eBay listings only
#   all   both
# LINEN_SOURCES=mock

# eBay API keys, from https://developer.ebay.com/my/keys (App ID = client id,
# Cert ID = client secret). Sandbox and production have separate key sets.
# Put the real values in .env.local, which git ignores. Never commit them.
# Without keys, eBay stays off and Settings says so.
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# sandbox (default) or production. Sandbox listings are test data.
# EBAY_ENV=sandbox
